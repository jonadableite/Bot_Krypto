# Configurações de Trading
SYMBOL=BTCUSDT
INTERVAL=15m
BACKTEST_DAYS=60
INITIAL_BALANCE=10000
RISK_PER_TRADE=0.03
STOP_LOSS_PERCENTAGE=0.02
TAKE_PROFIT_RATIO=1.5

# Configurações de Indicadores
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_SHORT=12
EMA_MEDIUM=26
EMA_LONG=50
VOLUME_PERIOD=20
ATR_PERIOD=14

# Configurações de Stop Loss
TRAILING_STOP_ACTIVATION=0.005
TRAILING_STOP_DISTANCE=0.01

# Configurações do Modelo de Previsão
LOOKBACK_WINDOW=50
NUM_FEATURES=13
LEARNING_RATE=0.001
TRAINING_ITERATIONS=100
BATCH_SIZE=32

# Configurações do WhatsApp
WHATSAPP_API_KEY="chave da api do whatsapp"
WHATSAPP_INSTANCE="instance do whatsapp"
PHONE_NUMBER="numero de telefone que recebera as mensagens"

# Configurações da API da Binance (se necessário)
BINANCE_API_KEY="sua_chave_api_da_binance"
BINANCE_API_SECRET="seu_segredo_api_da_binance"
